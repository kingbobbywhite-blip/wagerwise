# Odds feed key from https://the-odds-api.com
# Without this the app has no sportsbook prices, and it will refuse to price
# anything rather than invent an edge. Copy this file to .env.local and fill it in.
ODDS_API_KEY=

# Optional: PropLine key from https://prop-line.com (1,000 requests a day free).
# Either prices the slate (Settings -> Odds feed -> PropLine) or, alongside The
# Odds API, supplies the lines PrizePicks and Underdog are actually posting.
PROPLINE_API_KEY=
